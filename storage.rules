rules_version = '2';
// BVG / ALORA Asistencia — Firebase Storage rules
//
// Deploy ONLY after the Google sign-in dashboard is live on GitHub Pages.
// Publishing this file while the live page is still PIN-only blocks capturas.
//   npx -y firebase-tools@latest login
//   npx -y firebase-tools@latest use rentasbvg-50a41
//   firebase deploy --only storage
//
// Or paste this file in Firebase Console → Storage → Rules → Publish.
//
// Rollback: the previous rules allowed public read/write ONLY under the two
// captura folders below (the rest of the bucket stayed closed).
//
// Read/write now requires a signed-in, verified Google account on the allowlist:
//   Koke (admin): coquegaytan@gmail.com
//   Valeria (staff): martinezcalderonedithvaleria@gmail.com

service firebase.storage {
  match /b/{bucket}/o {
    function bvgAllowlisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower() == 'coquegaytan@gmail.com'
          || request.auth.token.email.lower() == 'martinezcalderonedithvaleria@gmail.com'
        );
    }

    function asCapturaWriteOk() {
      return bvgAllowlisted()
        && (request.resource == null
            || (request.resource.size < 300 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    match /bvg/asistencia/{shiftId}/{fileName} {
      allow read: if bvgAllowlisted();
      allow write: if asCapturaWriteOk();
    }

    match /bvg/peticiones/{peticionId}/{fileName} {
      allow read: if bvgAllowlisted();
      allow write: if asCapturaWriteOk();
    }
  }
}
